{
  "name": "@openclaw/webhub",
  "version": "0.1.0",
  "description": "OpenClaw Channel SDK - Build custom channel plugins",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "openclaw",
    "channel",
    "sdk"
  ],
  "author": "OpenClaw Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chatu-ai/openclaw-web-hub-channel.git"
  },
  "bugs": {
    "url": "https://github.com/chatu-ai/openclaw-web-hub-channel/issues"
  },
  "homepage": "https://github.com/chatu-ai/openclaw-web-hub-channel",
  "engines": {
    "node": ">=18.0.0",
    "openclaw": ">=1.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=1.0.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "uuid": "^13.0.0",
    "ws": "^8.14.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.3.0"
