{
  "id": "chatu-webhub",
  "name": "WebHub",
  "version": "0.1.0",
  "description": "Connect OpenClaw to any Website via HTTP/WebSocket",
  "kind": "channel",
  "channels": [
    "webhub"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiUrl": {
        "type": "string",
        "format": "uri"
      },
      "accessToken": {
        "type": "string"
      }
    }
  }
}
