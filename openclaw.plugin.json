{
  "id": "webhub",
  "name": "WebHub",
  "version": "0.1.0",
  "description": "Connect OpenClaw to any Website via HTTP/WebSocket",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "apiUrl": {
        "type": "string",
        "format": "uri"
      },
      "accessToken": {
        "type": "string"
      }
    }
  }
}
